<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TUnit tests are an executable: run them with `dotnet run`. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <ProjectReference Include="../../src/ChefBot.Core/ChefBot.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped data files, so tests can check they agree with each other. -->
    <Content Include="../../config/*.json" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Saved recipe pages, trimmed to what the readers look at. -->
    <Content Include="Pages/*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
