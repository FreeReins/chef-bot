<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- MSBuild's default is obj\ with a backslash, which dotnet watch 10.0 puts unchanged into the path of
         staticwebassets.development.json, so on Linux it can't read that file and static file hot reload fails. -->
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Lets the build report the IDE rules set in .editorconfig (IDE0005, IDE0130). -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CS1591: not every public member needs an XML comment. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!-- Enforces one type per file; .editorconfig turns its other rules off. -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
