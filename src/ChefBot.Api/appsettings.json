{
  "Database": {
    "Mode": "Bundled",
    "Port": 54329,
    "Binaries": "pgsql/bin"
  },
  "Data": {
    "Root": "",
    "IngredientCatalog": "config/ingredients.json",
    "SampleRecipes": "config/sample-recipes.json",
    "KnownStores": "config/stores.json",
    "PlanStyles": "config/plan-styles.json",
    "SessionKeys": "keys",
    "Backups": "backups"
  },
  "Https": {
    "Mode": "Off",
    "HttpPort": 8080,
    "Port": 8443,
    "PublicPort": 8443,
    "Hostnames": "",
    "CertificatePath": "",
    "KeyPath": "",
    "CertificatePassword": "",
    "TrustedProxies": ""
  },
  "Accounts": {
    "RecoverUsername": ""
  },
  "Planner": {
    "DefaultServings": 4,
    "Weights": {
      "SharedPerishable": 3,
      "StrandedPerishable": -1,
      "Seasonal": 3,
      "OnHand": 1.5,
      "ExpiringSoon": 4,
      "SameProtein": -3,
      "MissingIngredient": -0.5,
      "RegeneratePantryBoost": 4
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
