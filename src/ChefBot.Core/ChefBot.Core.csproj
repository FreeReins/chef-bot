<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything below the API: public contracts (Contracts/), and the internal managers, engines, resource
    accessors and utilities behind them. Only Contracts/ and CoreRegistration are public.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Reads recipe web pages: their JSON-LD, microdata, and the HTML that site readers pick apart. -->
    <PackageReference Include="AngleSharp" />
    <!-- Talks to Claude for the AI features, when an admin sets up an Anthropic model. -->
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ChefBot.Core.Tests" />
  </ItemGroup>
</Project>
